# Loaded by `astro dev --mode test` (the app) and by playwright.config.ts (the tests).
# The E2E suite runs against the LOCAL Supabase stack (npx supabase start); see .claude/rules/testing.md.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_KEY=###
OPENROUTER_HTTP_REFERER=###
OPENROUTER_X_TITLE=MindAgora

# The setup project registers this account (or signs it in) and reuses its session for the tests.
E2E_USERNAME=e2e@mindagora.local
E2E_PASSWORD=###
# Optional. Without it, scenarios that talk to OpenRouter (onboarding, conversation, list) are skipped.
E2E_OPENROUTER_KEY=###
# Optional. Defaults to http://localhost:3000.
# E2E_BASE_URL=http://localhost:3000
