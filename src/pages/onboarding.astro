---
import OnboardingView from "../components/onboarding/OnboardingView.tsx";
import Layout from "../layouts/Layout.astro";
import { getOnboardingStatus, resolveOnboardingStep } from "../lib/services/onboarding.service.ts";

// Behind the session (middleware). The step comes from the account state, never from the client.
const user = Astro.locals.user;
const email = user?.email ?? "";

const status = user ? await getOnboardingStatus({ supabase: Astro.locals.supabase, userId: user.id }) : null;
if (!status || status.error || !status.data) {
  // eslint-disable-next-line no-console
  console.error("Onboarding status lookup failed", {
    route: "/onboarding",
    status: 503,
    supabase_error_code: status?.error?.code,
  });
  return new Response("Could not load your account state. Please try again later.", { status: 503 });
}

const step = resolveOnboardingStep(status.data);
if (step === "complete") {
  return Astro.redirect("/");
}
---

<Layout title="Set up - MindAgora" user={{ email }}>
  <OnboardingView client:load step={step} />
</Layout>
