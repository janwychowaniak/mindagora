---
import Layout from "../layouts/Layout.astro";

// The middleware redirects anonymous visitors to /login, so `user` is always present here.
// Placeholder until the conversation list and onboarding views arrive with the UI plan.
const user = Astro.locals.user;
const email = user?.email ?? "";
---

<Layout user={{ email }}>
  <section class="space-y-3">
    <h1 class="text-2xl font-semibold tracking-tight">Welcome to MindAgora</h1>
    <p class="text-muted-foreground">
      Signed in as <span class="text-foreground">{email}</span>.
    </p>
    <p class="text-sm text-muted-foreground">Your conversations will appear here.</p>
  </section>
</Layout>
