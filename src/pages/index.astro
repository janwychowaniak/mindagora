---
import ConversationListView from "../components/conversations/ConversationListView.tsx";
import Layout from "../layouts/Layout.astro";
import { onboardingGate } from "../lib/onboarding-gate.ts";

// Behind the session (middleware) and the onboarding gate (UI plan ap7 §4).
const gate = await onboardingGate({ locals: Astro.locals, route: "/" });
if (gate) {
  return "redirect" in gate ? Astro.redirect(gate.redirect) : gate.response;
}
const email = Astro.locals.user?.email ?? "";
---

<Layout title="Conversations - MindAgora" user={{ email }}>
  <ConversationListView client:load />
</Layout>
