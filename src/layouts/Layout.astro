---
import "../styles/global.css";
import LogoutButton from "../components/auth/LogoutButton.tsx";

interface Props {
  title?: string;
  // The page passes the signed-in user as a prop (from Astro.locals); no session endpoint, no store.
  user?: { email: string } | null;
}

const { title = "MindAgora", user = null } = Astro.props;
const HELP_URL = "https://github.com/janwychowaniak/mindagora#readme";

const pathname = Astro.url.pathname;
const navLinks = [
  { href: "/", label: "Conversations", active: pathname === "/" || pathname.startsWith("/conversations") },
  { href: "/settings", label: "Settings", active: pathname.startsWith("/settings") },
];
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body class="min-h-screen bg-background text-foreground antialiased">
    <header class="border-b border-border">
      <div class="mx-auto flex h-14 max-w-5xl items-center justify-between px-4">
        <a href="/" class="text-lg font-semibold tracking-tight">MindAgora</a>
        {
          user && (
            <nav class="flex items-center gap-4 text-sm" aria-label="Main">
              {navLinks.map((link) => (
                <a
                  href={link.href}
                  aria-current={link.active ? "page" : undefined}
                  class:list={[
                    "transition-colors hover:text-foreground",
                    link.active ? "font-medium text-foreground" : "text-muted-foreground",
                  ]}
                >
                  {link.label}
                </a>
              ))}
              <a
                href={HELP_URL}
                target="_blank"
                rel="noopener noreferrer"
                class="text-muted-foreground transition-colors hover:text-foreground"
              >
                Help
              </a>
              <LogoutButton client:load />
            </nav>
          )
        }
      </div>
    </header>
    <main class="mx-auto max-w-5xl px-4 py-8">
      <slot />
    </main>
  </body>
</html>
